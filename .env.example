# Base URL for the json-server backend (see `npm run server`)
VITE_API_URL=http://localhost:3001

# Unsplash API access key, used to search for item images in the Add/Edit Item modal.
# Create a free app at https://unsplash.com/oauth/applications to get an Access Key.
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
